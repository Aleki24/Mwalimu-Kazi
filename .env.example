# Supabase project: https://bwshuajtopdyaxkqtdao.supabase.co
#
# The publishable key ships in the client bundle by design — it identifies the
# project, it does not grant access. Row Level Security is what protects data,
# so never rely on the key being secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only: bypasses RLS entirely. Never put this in a client bundle,
# and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
